# Raspberry Pi 5 OS (Debian Bookworm based) build environment
FROM debian:bookworm

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive

# Install required dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    pkg-config \
    libwayland-dev \
    libxkbcommon-dev \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    libx11-dev \
    libglm-dev \
    libvulkan-dev \
    vulkan-tools \
    vulkan-validationlayers \
    mesa-vulkan-drivers \
    python3 \
    python3-pip \
    ninja-build \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install ccache for faster rebuilds
RUN apt-get update && apt-get install -y ccache && rm -rf /var/lib/apt/lists/*

# Set up working directory
WORKDIR /workspace

# Clone and build the samples by default
# This will be overridden when mounting local source
CMD ["/bin/bash"]
